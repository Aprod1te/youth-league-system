# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used exclusively by guarded maintenance scripts.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Destructive cleanup guardrails
CLEANUP_ALLOWED_PROJECT_REFS=local
CLEANUP_KEEP_ADMIN_EMAIL=admin@example.com

# Demo seed guardrails (defaults to local when omitted)
DEMO_SEED_ALLOWED_PROJECT_REFS=local
DEMO_SEED_ADMIN_EMAIL=admin@example.com
